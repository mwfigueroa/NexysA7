{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "RV32IMC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/cmake/riscv32imc-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.toolchains/ninja/ninja.exe",
        "NEORV32_IMEM_SIZE": "64k",
        "NEORV32_DMEM_SIZE": "32k",
        "NEORV32_DMEM_BASE": "0x80000000"
      }
    },
    {
      "name": "release",
      "displayName": "RV32IMC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/cmake/riscv32imc-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.toolchains/ninja/ninja.exe",
        "NEORV32_IMEM_SIZE": "64k",
        "NEORV32_DMEM_SIZE": "32k",
        "NEORV32_DMEM_BASE": "0x80000000"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ]
}
