{
  "version": 4,
  "configurations": [
    {
      "name": "RV32IMC",
      // Toma los flags exactos (incluido el include de NEORV32) del build de CMake.
      // Requiere haber configurado al menos una vez: cmake --preset debug
      "compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
      "compilerPath": "${workspaceFolder}/.toolchains/xpack-riscv-none-elf-gcc-14.2.0-3/bin/riscv-none-elf-g++.exe",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "gcc-x86"
    }
  ]
}
